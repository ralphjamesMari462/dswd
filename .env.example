# Copy this file to .env for local use. Never commit .env.
# Never put secrets in VITE_ variables. The browser must not receive AI_API_KEY.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Truthful name shown in the consent notice.
AI_PROVIDER_LABEL=OpenAI

# Local server only. Leave PORT, HOST, and CAMERA_URL unset on Vercel.
PORT=80
HOST=0.0.0.0
# Optional local HTTPS address for phone cameras. Do not set this on Vercel.
CAMERA_URL=
# Optional on Vercel only, for a custom domain. Example: checker.example.gov.ph
# Also set this to the public hostname when the API is hosted somewhere other than Vercel.
APP_HOSTS=
# Public API only. Exact HTTPS origins allowed to call this API, such as https://YOUR_USER.github.io
# Leave empty for same-origin use. Do not put an API key here.
API_ALLOWED_ORIGINS=
# GitHub Pages build only. Public HTTPS address of the separately hosted API.
# Example: https://dswd-sanchez.vercel.app
# Leave empty for same-origin /api. Never put an API key in this value.
VITE_API_BASE_URL=
